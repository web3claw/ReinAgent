{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReinAgent",
  "version": "0.1.1",
  "identifier": "com.web3claw.reinagent",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "app": {
    "windows": [
      {
        "title": "ReinAgent",
        "width": 1800,
        "height": 1200,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGN0RFQ0JGOUJERDZBQkIKUldTN2F0MmJ2K3g5bitsSlpQYmVNbUFXWUxWN2VuRktBZmNvWlZyNWpUZXBscjRrcDduVDVIU2YK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
